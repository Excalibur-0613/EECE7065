def Compute_FLC(flc,Err,Errd):
    flc.input['Er'] = Err
    flc.input['Erd'] = Errd
    flc.compute()
    out=flc.output['u']
    return out

def error_fun(po,pa,cl,Ero):
    dao=np.linalg.norm(po-pa)

    #normalize between -1 and 1
    #Er = 2*((dao-dat)-mn)/(mx-mn)-1
    Er=dao-cl
    #Er=(dao-dat)/max(dao+dat)
    if Ero == None:
        Ero = Er
        
    #Erd=2*( (Er-Ero)/dt -mnd)/(mxd-mnd)-1
    Erd=(Er-Ero)/dt
    return Er, Erd


