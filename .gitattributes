def Tension(mu, pa, po):
    dao = np.linalg.norm(pa-po)
    
    T = (K*(dao-mu)) * (pa-po)/dao 

    if dao<mu:
        T=np.array([0, 0])
    return T
def MU(mu,mud,dt):
    UB=2
    LB=0.5
    mu=mu+mud*dt
    if mu>UB:
        mu=2
    elif mu<LB:
        mu=1
    return mu
def FLC():
########### FUZZY LOGIC CONTROLLER #####################
    #Tension = ctrl.Antecedent(np.arange(-500, 500, 1), 'Tension')
    Er = ctrl.Antecedent(np.arange(-1, 1, 0.01), 'Er')
    Erd = ctrl.Antecedent(np.arange(-1, 1, 0.01), 'Erd')
    u = ctrl.Consequent(np.arange(-1, 1, 0.005), 'u')
    
    
    BEr=1
    # stdERN=0.8
    stdERZ=0.1
    stdER=0.9
    
    Er['N'] = fuzz.gaussmf(Er.universe, -BEr, stdER)
    Er['Z'] = fuzz.gaussmf(Er.universe, 0, stdERZ)
    Er['P'] = fuzz.gaussmf(Er.universe, BEr, stdER)
    
    
    BErd=1
    # stdERdN=0.8
    stdERdZ=0.1
    stdERd=0.9
    Erd['N'] = fuzz.gaussmf(Erd.universe, -BErd, stdERd)#(Erd.universe, [-500000, -ERdmb, -0.2])
    Erd['Z'] = fuzz.gaussmf(Erd.universe, 0, stdERdZ)#(Erd.universe, [-ERdmb, 0, ERdmb])
    Erd['P'] = fuzz.gaussmf(Erd.universe, BErd, stdERd)#(Erd.universe, [0.2, ERdmb, 500000])
    
    
    Bu=1
    # stduN=0.5
    stduZ=0.1
    stdu=0.9
    u['N'] = fuzz.gaussmf(u.universe, -Bu, stdu)
    u['Z'] = fuzz.gaussmf(u.universe, 0, stduZ)
    u['P'] = fuzz.gaussmf(u.universe, Bu, stdu)
    
    rule1=ctrl.Rule(Er['N'] & Erd['N'],u['P']) #P let out line
    rule2=ctrl.Rule(Er['N'] & Erd['Z'],u['P'])
    rule3=ctrl.Rule(Er['N'] & Erd['P'],u['P'])
    rule4=ctrl.Rule(Er['Z'] & Erd['N'],u['P'])
    rule5=ctrl.Rule(Er['Z'] & Erd['Z'],u['Z'])
    rule6=ctrl.Rule(Er['Z'] & Erd['P'],u['N']) #N take in line
    rule7=ctrl.Rule(Er['P'] & Erd['N'],u['N'])
    rule8=ctrl.Rule(Er['P'] & Erd['Z'],u['N'])
    rule9=ctrl.Rule(Er['P'] & Erd['P'],u['N'])
    Tensor_ctrl = ctrl.ControlSystem([rule1, rule4, rule7,
                                        rule2, rule5, rule8, 
                                        rule3, rule6, rule9])
    FUZZ = ctrl.ControlSystemSimulation(Tensor_ctrl)

    return FUZZ
